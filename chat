import telebot
import sqlite3
import random

TOKEN = "8060035880:AAFlbyjTbZpOPvwIUaADPD5Zo-ZSgS6WvSw"
bot = telebot.TeleBot(TOKEN)

# إنشاء قاعدة بيانات لتخزين المستخدمين المنتظرين
conn = sqlite3.connect("users.db", check_same_thread=False)
cursor = conn.cursor()
cursor.execute("""
    CREATE TABLE IF NOT EXISTS waiting_users (
        user_id INTEGER PRIMARY KEY,
        country TEXT
    )
""")
cursor.execute("""
    CREATE TABLE IF NOT EXISTS active_chats (
        user1 INTEGER,
        user2 INTEGER
    )
""")
conn.commit()

# دالة لإضافة مستخدم إلى قائمة الانتظار
def add_to_waiting(user_id, country):
    cursor.execute("INSERT OR REPLACE INTO waiting_users (user_id, country) VALUES (?, ?)", (user_id, country))
    conn.commit()

# دالة لحذف المستخدم من قائمة الانتظار
def remove_from_waiting(user_id):
    cursor.execute("DELETE FROM waiting_users WHERE user_id = ?", (user_id,))
    conn.commit()

# دالة لإيجاد شريك محادثة من بلد مختلف
def find_partner(user_id, user_country):
    cursor.execute("SELECT * FROM waiting_users WHERE country != ? LIMIT 1", (user_country,))
    partner = cursor.fetchone()
    if partner:
        partner_id = partner[0]
        remove_from_waiting(partner_id)
        remove_from_waiting(user_id)
        cursor.execute("INSERT INTO active_chats (user1, user2) VALUES (?, ?)", (user_id, partner_id))
        conn.commit()
        return partner_id
    return None

# دالة لإيجاد الشريك الحالي
def get_partner(user_id):
    cursor.execute("SELECT * FROM active_chats WHERE user1 = ? OR user2 = ?", (user_id, user_id))
    chat = cursor.fetchone()
    if chat:
        return chat[1] if chat[0] == user_id else chat[0]
    return None

# دالة لإنهاء المحادثة
def end_chat(user_id):
    cursor.execute("DELETE FROM active_chats WHERE user1 = ? OR user2 = ?", (user_id, user_id))
    conn.commit()

# أمر بدء البوت
@bot.message_handler(commands=['start'])
def start(message):
    bot.send_message(message.chat.id, "مرحبًا! أرسل بلدك للعثور على شريك محادثة.\nمثال: 🇺🇸 أو 🇸🇦")

# استقبال اسم الدولة لبدء البحث
@bot.message_handler(func=lambda message: len(message.text) == 2)
def receive_country(message):
    user_id = message.chat.id
    country = message.text
    partner_id = find_partner(user_id, country)

    if partner_id:
        bot.send_message(user_id, "تم العثور على شريك! يمكنك الآن الدردشة.")
        bot.send_message(partner_id, "تم العثور على شريك! يمكنك الآن الدردشة.")
    else:
        add_to_waiting(user_id, country)
        bot.send_message(user_id, "جارٍ البحث عن شريك من دولة أخرى...")

# استقبال الرسائل ونقلها بين المستخدمين
@bot.message_handler(func=lambda message: True)
def chat(message):
    user_id = message.chat.id
    partner_id = get_partner(user_id)

    if partner_id:
        bot.send_message(partner_id, message.text)
    else:
        bot.send_message(user_id, "ليس لديك شريك حاليًا. أرسل بلدك للعثور على شريك جديد.")

# أمر إنهاء المحادثة
@bot.message_handler(commands=['stop'])
def stop_chat(message):
    user_id = message.chat.id
    partner_id = get_partner(user_id)

    if partner_id:
        bot.send_message(partner_id, "تم إنهاء المحادثة من قبل الطرف الآخر.")
        bot.send_message(user_id, "تم إنهاء المحادثة.")
        end_chat(user_id)
    else:
        bot.send_message(user_id, "ليس لديك محادثة نشطة.")

# تشغيل البوت
bot.polling()
