# استقبال اسم الدولة لبدء البحث
@bot.message_handler(func=lambda message: len(message.text) == 2)
def receive_country(message):
    user_id = message.chat.id
    username = message.from_user.username or f"User_{user_id}"
    country = message.text
    partner_id = find_partner(user_id, username, country)

    if partner_id:
        bot.send_message(user_id, "✅ تم العثور على شريك! يمكنك الآن الدردشة.", reply_markup=main_menu())
        bot.send_message(partner_id, "✅ تم العثور على شريك! يمكنك الآن الدردشة.", reply_markup=main_menu())
    else:
        add_to_waiting(user_id, username, country)
