# استقبال الرسائل ونقلها بين المستخدمين
@bot.message_handler(func=lambda message: True)
def chat(message):
    user_id = message.chat.id
    partner_id = get_partner(user_id)

    if partner_id:
        bot.send_message(partner_id, message.text)
    else:
        bot.send_message(user_id, "❌ ليس لديك شريك حاليًا. اضغط **🔍 العثور على شريك** للبدء.")

# عند الضغط على زر "🛑 إنهاء المحادثة"
@bot.message_handler(func=lambda message: message.text == "🛑 إنهاء المحادثة")
def stop_chat(message):
    user_id = message.chat.id
    partner_id = get_partner(user_id)

    if partner_id:
        bot.send_message(partner_id, "⚠️ تم إنهاء المحادثة من قبل الطرف الآخر.", reply_markup=main_menu())
        bot.send_message(user_id, "✅ تم إنهاء المحادثة.", reply_markup=main_menu())
        end_chat(user_id)
    else:
        bot.send_message(user_id, "❌ ليس لديك محادثة نشطة.", reply_markup=main_menu())

# أمر /users - يسمح فقط للمسؤول برؤية القائمة
@bot.message_handler(commands=['users'])
def list_users(message):
    if message.chat.id != ADMIN_ID:
        bot.send_message(message.chat.id, "❌ ليس لديك صلاحية لاستخدام هذا الأمر.")
        return
    
    cursor.execute("SELECT username, country FROM waiting_users")
    waiting_users = cursor.fetchall()
    
    cursor.execute("SELECT user1, user2 FROM active_chats")
    active_chats = cursor.fetchall()
    
    user_list = "📋 **قائمة المستخدمين:**\n\n"
    
    if waiting_users:
        user_list += "🟢 **في الانتظار:**\n"
        for user in waiting_users:
            user_list += f"- @{user[0]} ({user[1]})\n"
    else:
        user_list += "❌ لا يوجد مستخدمون في الانتظار.\n"
    
    if active_chats:
        user_list += "\n🔵 **المحادثات النشطة:**\n"
        for chat in active_chats:
            user_list += f"- {chat[0]} 🔄 {chat[1]}\n"
    else:
        user_list += "\n❌ لا توجد محادثات نشطة.\n"

    bot.send_message(ADMIN_ID, user_list, parse_mode="Markdown")

